# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=local                # local | staging | production
APP_NAME=FastAPI Boilerplate
SITE_DOMAIN=example.com          # used by Caddy for TLS

# ─── Database (use "db" as POSTGRES_SERVER inside Docker) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis (use "redis" as REDIS_HOST inside Docker) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
CORS_HEADERS=["*"]
# CORS_ORIGINS_REGEX=

# ─── Auth (JWT + OTP) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-32-bytes
JWT_ALG=HS256
JWT_EXP=15                       # access token lifetime, minutes
OTP_EXP=300                      # OTP lifetime, seconds
OTP_LENGTH=6
OTP_DEBUG_LOG=false              # local only: log the plaintext OTP
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_TTL=900
OTP_IP_DAILY_LIMIT=20
OTP_GLOBAL_DAILY_LIMIT=2000

# Local-only superuser bootstrap (scripts/create_superuser.py)
SUPERUSER_PHONE=+998900000000
# SUPERUSER_PASSWORD=

# ─── Eskiz SMS gateway ────────────────────────────────────────────────────────
# Leave email/password blank to run in stub mode (OTPs are logged, not sent).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Process tuning ───────────────────────────────────────────────────────────
WEB_CONCURRENCY=2                # uvicorn worker count in container
